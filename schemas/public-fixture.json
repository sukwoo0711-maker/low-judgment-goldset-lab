{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public reference fixture",
  "type": "object",
  "required": ["question_id", "fact_cluster_id", "query", "source_type", "source_title", "retrieved_at", "source_revision", "content_digest", "derivation", "private_input_used", "license_basis", "reference_answer", "predicates"],
  "properties": {
    "question_id": {"type": "string", "minLength": 1},
    "fact_cluster_id": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["public_web", "synthetic_template"]},
    "source_url": {"type": "string", "pattern": "^https://"},
    "source_title": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "source_revision": {"type": "string", "minLength": 1},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "derivation": {"type": "string", "minLength": 1},
    "private_input_used": {"const": false},
    "license_basis": {"type": "string", "minLength": 1},
    "reference_answer": {"type": "string", "minLength": 1},
    "predicates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["predicate_id", "text"],
        "properties": {
          "predicate_id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "importance": {"enum": ["mandatory", "optional", "excluded"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
